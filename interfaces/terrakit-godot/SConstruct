#!/usr/bin/env python

import os
import sys


INTERFACE_DIR = Dir("#").abspath
REPO_ROOT = os.path.abspath(
    os.path.join(INTERFACE_DIR, "..", "..")
)

TERRAKIT_INCLUDE_DIR = os.path.join(
    REPO_ROOT,
    "bindings",
    "c",
    "include",
)

ADDON_BIN_DIR = os.path.join(
    INTERFACE_DIR,
    "addon",
    "addons",
    "terrakit",
    "bin",
)


if not os.path.isdir(
    os.path.join(INTERFACE_DIR, "godot-cpp")
):
    print(
        "godot-cpp is missing.\n"
        "Run:\n"
        "  git submodule update --init --recursive"
    )
    Exit(1)


env = SConscript(
    "godot-cpp/SConstruct",
    {
        "api_version": "4.7",
    },
)

target = env["target"]

if target == "template_debug":
    terrakit_profile = "debug"
elif target == "template_release":
    terrakit_profile = "release"
else:
    print(
        "Unsupported Godot build target:\n"
        f"  {target}"
    )
    Exit(1)

TERRAKIT_TARGET_DIR = os.path.join(
    REPO_ROOT,
    "target",
    terrakit_profile,
)

env.Append(
    CPPPATH=[
        os.path.join(INTERFACE_DIR, "src"),
        TERRAKIT_INCLUDE_DIR,
    ],
)

sources = Glob(
    os.path.join(
        INTERFACE_DIR,
        "src",
        "*.cpp",
    )
)


platform = env["platform"]


if platform == "windows":
    terrakit_runtime = os.path.join(
        TERRAKIT_TARGET_DIR,
        "terrakit.dll",
    )

    terrakit_import = os.path.join(
        TERRAKIT_TARGET_DIR,
        "terrakit.dll.lib",
    )

    if not os.path.isfile(terrakit_runtime):
        print(
            "TerraKit DLL not found:\n"
            f"  {terrakit_runtime}\n\n"
            "Build TerraKit first:\n"
            "  cargo build -p terrakit-c-api --all-features"
        )
        Exit(1)

    if not os.path.isfile(terrakit_import):
        print(
            "TerraKit import library not found:\n"
            f"  {terrakit_import}"
        )
        Exit(1)

    env.Append(
        CPPDEFINES=[
            "TK_USE_SHARED",
        ],
    )

    env.Append(
        LINKFLAGS=[
            terrakit_import,
        ],
    )

    runtime_copy = env.Install(
        os.path.join(
            ADDON_BIN_DIR,
            "windows",
        ),
        terrakit_runtime,
    )


elif platform == "linux":
    terrakit_runtime = os.path.join(
        TERRAKIT_TARGET_DIR,
        "libterrakit.so",
    )

    if not os.path.isfile(terrakit_runtime):
        print(
            "TerraKit shared library not found:\n"
            f"  {terrakit_runtime}\n\n"
            "Build TerraKit first:\n"
            "  cargo build -p terrakit-c-api --all-features"
        )
        Exit(1)

    env.Append(
        LIBPATH=[
            TERRAKIT_TARGET_DIR,
        ],
    )

    env.Append(
        LIBS=[
            "terrakit",
        ],
    )

    # Make libterrakit.so discoverable beside the GDExtension.
    env.Append(
        LINKFLAGS=[
            "-Wl,-rpath,$$ORIGIN",
        ],
    )

    runtime_copy = env.Install(
        os.path.join(
            ADDON_BIN_DIR,
            "linux",
        ),
        terrakit_runtime,
    )


else:
    print(
        "TerraKit Godot currently supports "
        "Windows and Linux builds only."
    )
    Exit(1)


# Match godot-cpp's standard output naming convention.
suffix = env["suffix"].replace(
    ".dev",
    "",
).replace(
    ".universal",
    "",
)

library_filename = "{}terrakit_godot{}{}".format(
    env.subst("$SHLIBPREFIX"),
    suffix,
    env.subst("$SHLIBSUFFIX"),
)

library = env.SharedLibrary(
    os.path.join(
        ADDON_BIN_DIR,
        platform,
        library_filename,
    ),
    source=sources,
)

env.NoCache(library)

Default(
    library,
    runtime_copy,
)
[configuration]

entry_symbol = "terrakit_godot_library_init"
compatibility_minimum = "4.7"
reloadable = false


[libraries]

windows.x86_64.single.debug = "./bin/windows/terrakit_godot.windows.template_debug.x86_64.dll"
windows.x86_64.single.release = "./bin/windows/terrakit_godot.windows.template_release.x86_64.dll"

linux.x86_64.single.debug = "./bin/linux/libterrakit_godot.linux.template_debug.x86_64.so"
linux.x86_64.single.release = "./bin/linux/libterrakit_godot.linux.template_release.x86_64.so"